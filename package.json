{
  "name": "routy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "granite dev",
    "dev:vite": "vite --host",
    "build": "ait build",
    "build:vite": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "deploy": "ait deploy",
    "icons": "node scripts/generate-icons.mjs",
    "screenshots": "node scripts/generate-screenshots.mjs",
    "screenshots:appstore": "SCREENSHOT_PROFILE=appstore node scripts/generate-screenshots.mjs",
    "screenshots:ipad": "SCREENSHOT_PROFILE=ipad node scripts/generate-screenshots.mjs",
    "ios:sync": "npm run build:vite && npx cap sync ios",
    "ios:open": "npm run build:vite && npx cap sync ios && npx cap open ios"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "playwright": "^1.60.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "^2.6.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/status-bar": "^8.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
